# PostgreSQL database URL
# For Docker Compose: postgresql+asyncpg://postgres:postgres@postgres:5432/skillmatch_pro
# For local dev: postgresql+asyncpg://postgres:postgres@localhost:5432/skillmatch_pro
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/skillmatch_pro

# Security
# Generate a secure key for production! (e.g., openssl rand -hex 32)
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Job Provider (mock | seeded | himalayas)
JOB_PROVIDER=seeded

# LLM Provider (mock | openai)
LLM_PROVIDER=mock
OPENAI_API_KEY=

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
